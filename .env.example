# Mistral API key (structured outputs). Required for ingestion and for answering claims.
MISTRAL_API_KEY=
# Model for segmentation and decisions.
MISTRAL_MODEL=ministral-14b-latest
# Path of the SQLite database built by `sinistres build`.
DB_PATH=data/sinistres.db
# Stronger model the cascade escalates to (Google AI Studio key).
GEMINI_API_KEY=
ESCALATION_MODEL=gemini-3.8-flash
# Gemini through Vertex AI (preferred: billed to the project, no key). Leave empty to use GEMINI_API_KEY.
VERTEX_PROJECT=
# strong (deployed) | cascade | cheap
DECISION_MODE=strong
